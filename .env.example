# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection (required). With `npm run db:dev` the local cluster uses this exact URL.
DATABASE_URL=postgres://aptima:aptima@127.0.0.1:54320/aptimacrm

# Object storage. STORAGE_DRIVER=local writes to STORAGE_LOCAL_DIR (dev/test only).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
# Used when STORAGE_DRIVER=s3 (any S3-compatible service)
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=aptimacrm-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Inbound BCC / forwarding capture (required if the endpoint is enabled)
INBOUND_EMAIL_SECRET=replace-with-openssl-rand-hex-32
# Address that users BCC; shown on deal detail
INBOUND_EMAIL_ADDRESS=capture@crm.example.com

# Org configuration
ORG_TIMEZONE=Europe/Madrid
ORG_CURRENCY=EUR

# Seed passwords used only by `npm run db:seed` (development). Change before any shared use.
SEED_PASSWORD=change-me-seed-password

# Set to 'true' only behind HTTPS to mark cookies Secure (defaults to NODE_ENV=production)
# COOKIE_SECURE=true
